CREATE PROCEDURE yazar_kitaplari (
    @yazar_ad VARCHAR(30) = NULL, 
    @yazar_soyad VARCHAR(30) = NULL
)
AS
    SET NOCOUNT ON
    
    SELECT YAZARLAR.Yazar_adi, YAZARLAR.Yazar_soyadi, KITAPLAR.Kitap_adi 
    FROM KITAP_YAZAR 
    INNER JOIN KITAPLAR ON KITAP_YAZAR.ISBN = KITAPLAR.ISBN 
    INNER JOIN YAZARLAR ON KITAP_YAZAR.Yazar_no = YAZARLAR.Yazar_no
    WHERE (YAZARLAR.Yazar_adi = @yazar_ad) 
      AND (YAZARLAR.Yazar_soyadi = @yazar_soyad)
GO

-- Çalıştırmak (Çağırmak) için:
EXEC yazar_kitaplari 'Ebubekir', 'Yaşar'
